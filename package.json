{
  "name": "english-quiz",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest",
    "check": "node ops/check-all.mjs",
    "check:remote": "node ops/check-remote.mjs",
    "hooks:install": "node ops/install-check-hook.mjs",
    "build:preview": "node ops/build-preview.mjs",
    "preview:workbench": "node ops/build-learning-production-assets.mjs && node ops/preview-learning-workbench.mjs",
    "probe:gemini": "node --env-file-if-exists=.gemini.local.env ops/probe-gemini-quiz.mjs",
    "preview:gemini": "node --env-file-if-exists=.gemini.local.env ops/preview-gemini-workbench.mjs",
    "preview:ai": "node --env-file-if-exists=.gemini.local.env --env-file-if-exists=.azure.local.env ops/preview-ai-workbench.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "jose": "6.2.12",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@vitest/ui": "^1.6.0",
    "esbuild": "0.28.2",
    "happy-dom": "^21.0.3",
    "jsdom": "^29.1.1",
    "jsqr": "1.4.0",
    "miniflare": "5.20261019.2-beta",
    "playwright": "1.62.1",
    "vitest": "^1.6.0",
    "wrangler": "4.152.0"
  },
  "vitest": {
    "include": [
      "test/**/*.test.js"
    ],
    "exclude": [
      "src/**/*.test.mjs"
    ]
  }
}
